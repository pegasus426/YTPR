<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - YouTube Music Randomizer</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>🎵 Dashboard</h1>
      <div class="header-actions">
        <a href="/logout" class="btn btn-secondary btn-small">Disconnetti</a>
      </div>
    </header>

    <main>
      <div class="card">
        <h2>Genera Playlist Casuale</h2>
        
        <div class="form-group">
          <label for="artistCount">Numero di artisti da includere:</label>
          <input type="number" id="artistCount" min="1" max="20" value="5">
          <small>Selezionerà casualmente tra i canali che segui</small>
        </div>

        <div class="form-group">
          <label for="songsPerArtist">Brani per artista:</label>
          <input type="number" id="songsPerArtist" min="1" max="10" value="3">
          <small>Numero di brani casuali per ogni artista</small>
        </div>

        <button id="generateBtn" class="btn btn-primary">
          🎲 Genera Playlist Casuale
        </button>

        <div id="loading" class="loading" style="display: none;">
          <div class="spinner"></div>
          <p>Generazione della playlist in corso...</p>
        </div>
      </div>

      <div id="playlistPreview" class="card" style="display: none;">
        <h2>📋 Anteprima Playlist</h2>
        <div id="playlistStats" class="stats"></div>
        
        <div id="videoList" class="video-list"></div>

        <div class="save-section">
          <h3>Salva su YouTube</h3>
          <div class="form-group">
            <label for="playlistTitle">Nome della Playlist:</label>
            <input type="text" id="playlistTitle" placeholder="La mia playlist casuale">
          </div>
          
          <div class="form-group">
            <label for="playlistDescription">Descrizione (opzionale):</label>
            <textarea id="playlistDescription" rows="3" placeholder="Playlist generata casualmente il..."></textarea>
          </div>

          <div class="button-group">
            <button id="saveBtn" class="btn btn-success">
              💾 Salva su YouTube
            </button>
            <button id="regenerateBtn" class="btn btn-secondary">
              🔄 Genera Nuova
            </button>
          </div>
        </div>

        <div id="saveResult" class="result-message" style="display: none;"></div>
      </div>

      <div id="error" class="error-message" style="display: none;"></div>
    </main>

    <footer>
      <p>YouTube Music Random Playlist Generator</p>
    </footer>
  </div>

  <script src="/app.js"></script>
</body>
</html>
